# Password required to access /admin (the menu editor).
# Copy this file to .env.local and set a real password before deploying.
ADMIN_PASSWORD=changeme123

# Supabase project used for the menu/orders database (categories, dishes,
# orders, order_items, couriers) and the menu-images Storage bucket.
# URL is public; the service_role key is a secret — never commit it,
# never expose it to the browser. Find it in the Supabase dashboard:
# Project Settings -> API -> service_role secret key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Public site URL, used to build absolute links in robots.txt/sitemap.xml
# and Open Graph metadata. Optional in development.
SITE_URL=https://chaihana-rayhan.ru
