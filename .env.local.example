# Password required to access /admin (the menu editor).
# Copy this file to .env.local and set a real password before deploying.
ADMIN_PASSWORD=changeme123

# Supabase project used for the menu/orders database (categories, dishes,
# orders, order_items, couriers) and the menu-images Storage bucket.
# URL is public; the service_role key is a secret — never commit it,
# never expose it to the browser. Find it in the Supabase dashboard:
# Project Settings -> API -> service_role secret key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Public site URL, used to build absolute links in robots.txt/sitemap.xml,
# Open Graph metadata, and the Telegram bot webhook URL. Optional in
# development, required for Telegram notifications to work.
SITE_URL=https://chaihana-rayhan.ru

# Optional: Telegram bot for new-order notifications. Create a bot via
# @BotFather in Telegram, paste its token here, then in /admin/telegram
# click "Настроить бота" once (calls setWebhook). Anyone who then messages
# the bot /start is subscribed to order notifications.
TELEGRAM_BOT_TOKEN=

# Optional: online card payment via YooKassa (yookassa.ru). Needs a
# registered ИП/ООО and a YooKassa merchant account — find both values in
# the YooKassa dashboard under Settings -> API keys. Without these set,
# the "card online" option in checkout will fail to start a payment; every
# other checkout option keeps working.
#
# Also register the webhook URL in the YooKassa dashboard (Settings ->
# HTTP notifications) pointing at:
#   https://<your-site>/api/payments/yookassa/webhook
# for the "payment.succeeded" and "payment.canceled" events — without it,
# a paid order only gets created once the guest's browser lands back on
# /order/payment-result and the status check runs as a fallback.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
